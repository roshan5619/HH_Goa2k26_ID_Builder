{
  "name": "hh-goa-2026-id-builder",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Frame / ID Card Generator for Hacker House Goa 2026",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
